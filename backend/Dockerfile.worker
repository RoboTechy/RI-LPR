FROM python:3.11-slim

# libgl1/libglib2.0-0 - required by opencv-python-headless/ultralytics at import time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only torch/torchvision FIRST, from PyTorch's own CPU wheel index -
# ultralytics (installed next, via requirements-worker.txt) depends on
# torch but only needs it importable; the default PyPI torch wheel pulls
# in the entire CUDA 13 toolkit (cudnn, nccl, triton, a dozen nvidia-*
# packages, multiple GB) for a GPU this deployment doesn't have or need
# (CPU-only ONNX inference - see models/README.md). Installing the CPU
# build here first means it's already satisfied by the time pip resolves
# requirements-worker.txt's "torch>=1.8.0", so that huge resolution never
# gets pulled at all.
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY backend/requirements-worker.txt /app/backend/requirements-worker.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-worker.txt

COPY backend /app/backend
COPY license_plate_extractor.py /app/license_plate_extractor.py
COPY yolo11n.pt /app/yolo11n.pt
COPY models /app/models

WORKDIR /app

CMD ["python", "backend/worker/camera_worker.py"]
