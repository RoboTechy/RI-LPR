FROM python:3.11-slim

# libgl1/libglib2.0-0 - required by opencv-python-headless/ultralytics at
# import time. Retried + given more time: this network has repeatedly
# proven flaky enough that even apt can time out, not just pip.
RUN set -e; \
    for i in 1 2 3 4 5; do \
      apt-get update \
        -o Acquire::Retries=5 -o Acquire::http::Timeout=60 -o Acquire::https::Timeout=60 \
      && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
      && rm -rf /var/lib/apt/lists/* \
      && exit 0; \
      echo "apt-get attempt $i failed, retrying in 15s..."; \
      sleep 15; \
    done; \
    echo "apt-get failed after 5 attempts"; exit 1

# pip's default per-chunk read timeout (15s) is too short for some of
# these wheels (opencv, onnxruntime, torch) on a slower connection - hit
# a plain ReadTimeoutError downloading one of them. More time + retries
# instead of pip just giving up.
ENV PIP_DEFAULT_TIMEOUT=180
ENV PIP_RETRIES=10

WORKDIR /app

# CPU-only torch/torchvision FIRST, from PyTorch's own CPU wheel index -
# ultralytics (installed next, via requirements-worker.txt) depends on
# torch but only needs it importable; the default PyPI torch wheel pulls
# in the entire CUDA 13 toolkit (cudnn, nccl, triton, a dozen nvidia-*
# packages, multiple GB) for a GPU this deployment doesn't have or need
# (CPU-only ONNX inference - see models/README.md). Installing the CPU
# build here first means it's already satisfied by the time pip resolves
# requirements-worker.txt's "torch>=1.8.0", so that huge resolution never
# gets pulled at all.
#
# Both this and the requirements-worker.txt install below are wrapped in
# a retry loop: PIP_DEFAULT_TIMEOUT/PIP_RETRIES alone weren't enough on
# this connection - pip can fail to even fetch a package's version list
# within 180s and give up outright ("from versions: none") rather than
# retrying a fresh attempt. Earlier successful steps on this same
# network suggest the link drops in and out rather than being dead, so
# retrying the whole command is worth it.
RUN set -e; \
    for i in 1 2 3 4 5; do \
      pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && exit 0; \
      echo "pip install (torch) attempt $i failed, retrying in 15s..."; \
      sleep 15; \
    done; \
    echo "pip install (torch) failed after 5 attempts"; exit 1

COPY backend/requirements-worker.txt /app/backend/requirements-worker.txt
RUN set -e; \
    for i in 1 2 3 4 5; do \
      pip install --no-cache-dir -r /app/backend/requirements-worker.txt && exit 0; \
      echo "pip install attempt $i failed, retrying in 15s..."; \
      sleep 15; \
    done; \
    echo "pip install failed after 5 attempts"; exit 1

COPY backend /app/backend
COPY license_plate_extractor.py /app/license_plate_extractor.py
COPY yolo11n.pt /app/yolo11n.pt
COPY models /app/models

WORKDIR /app

CMD ["python", "backend/worker/camera_worker.py"]
