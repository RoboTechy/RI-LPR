# Copy this file to .env (same folder) and fill in real values before
# running docker compose up. .env itself is gitignored - never commit it.

# Shared key the Chrome extension sends on every request (X-API-Key
# header) - set the same value in extension/content.js's API_KEY
# constant.
EXTENSION_API_KEY=change-me-extension-key

# Random long string - signs the admin panel's login cookie.
SESSION_SECRET_KEY=change-me-session-secret

# Created automatically the first time the API starts, if no admin user
# exists yet. Log in and change the password (or add a new admin and
# delete this one) right after first deploy.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-now

# Minutes a detected plate stays selectable in the extension before it's
# considered stale. A truck that's still sitting there keeps this fresh
# on its own (see WORKER_PRESENCE_GAP_SECONDS below), so this mostly
# bounds a one-off misread that nobody acted on.
ACTIVE_PLATE_WINDOW_MINUTES=20

# Once a plate has been used on a saved permit, don't show that same
# plate text again (same camera) for this many minutes.
PLATE_SUPPRESS_AFTER_SAVE_MINUTES=60

# How often (seconds) each camera thread grabs a frame.
WORKER_POLL_INTERVAL_SECONDS=3

# How much two reads' vehicle positions must overlap (IoU, 0..1) to be
# treated as "the same truck still sitting there" rather than a new one.
WORKER_IOU_SAME_TRUCK_THRESHOLD=0.6

# If nothing is successfully read on a camera for this long (seconds),
# whatever was last seen there is assumed to have left.
WORKER_PRESENCE_GAP_SECONDS=30

# The Raspberry Pi relay service (../pi-relay-service/) that switches
# each line's traffic light red/green - a separate physical device on
# the plant network, not a container here. See its own README.md.
PI_RELAY_SERVICE_URL=http://192.168.201.50:8080
# Must match RELAY_API_KEY in pi-relay-service/.env.
PI_RELAY_API_KEY=change-me-relay-key
