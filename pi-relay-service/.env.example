# Copy to .env in this same folder and fill in a real key - must match
# PI_RELAY_API_KEY in the backend's own .env. Read automatically by
# ri-lpr-relay.service (systemd EnvironmentFile); if you're just running
# `python3 relay_service.py` directly instead, export these yourself or
# edit config.py's defaults directly.
RELAY_API_KEY=change-me-relay-key

# Uncomment to override the defaults in config.py:
# RELAY_PORT=8080
# RELAY_AUTO_REVERT_SECONDS=20
