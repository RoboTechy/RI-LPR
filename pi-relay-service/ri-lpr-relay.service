[Unit]
Description=RI-LPR traffic light relay service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# REPLACE_ME_DIR = this folder's real path, REPLACE_ME_USER = the Pi's
# login user (often "pi") - the README's sed command fills both in.
# Raspberry Pi OS gives members of the "gpio" group access to the GPIO
# pins, so no root is needed.
User=REPLACE_ME_USER
SupplementaryGroups=gpio
WorkingDirectory=REPLACE_ME_DIR
ExecStart=REPLACE_ME_DIR/.venv/bin/python3 REPLACE_ME_DIR/relay_service.py
EnvironmentFile=-REPLACE_ME_DIR/.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
