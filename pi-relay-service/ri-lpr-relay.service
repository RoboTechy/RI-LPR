[Unit]
Description=RI-LPR traffic light relay service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/ri-lpr/pi-relay-service
ExecStart=/usr/bin/python3 /home/pi/ri-lpr/pi-relay-service/relay_service.py
EnvironmentFile=-/home/pi/ri-lpr/pi-relay-service/.env
Restart=on-failure
RestartSec=3
User=pi

[Install]
WantedBy=multi-user.target
